{
  "library": "../.build/native/libdeskpet_inference.so",
  "harnessEnvFile": "../../LLM_test/.env",
  "hardwareSocket": "auto",
  "routeConfidenceThreshold": 0.3,
  "sttConfidenceThreshold": 0.3,
  "startupReminder": true,
  "models": {
    "router": { "backend": "llama.cpp", "role": "router", "device": "cuda", "paths": { "model": "router/backbone-merged-q4_0.gguf", "heads": "router/heads-f16.gguf", "config": "router/router_config.json", "chat_template": "router/tokenizer/chat_template.jinja" }, "contextTokens": 2560, "maxTokens": 128, "threads": 2 },
    "output": { "backend": "llama.cpp", "role": "output", "device": "cuda", "paths": { "model": "output/qwen-2b-q4_0.gguf" }, "contextTokens": 2048, "maxTokens": 128, "threads": 2 },
    "stt": { "backend": "sherpa-onnx", "role": "stt", "device": "cpu", "paths": {
      "conv_frontend": "stt/sherpa-onnx-qwen3-asr-0.6B-int8-2026-03-25/conv_frontend.onnx",
      "encoder": "stt/sherpa-onnx-qwen3-asr-0.6B-int8-2026-03-25/encoder.int8.onnx",
      "decoder": "stt/sherpa-onnx-qwen3-asr-0.6B-int8-2026-03-25/decoder.int8.onnx",
      "tokenizer": "stt/sherpa-onnx-qwen3-asr-0.6B-int8-2026-03-25/tokenizer"
    }, "contextTokens": 512, "maxTokens": 128, "threads": 4 },
    "vad": { "backend": "sherpa-onnx", "role": "vad", "device": "cpu", "paths": { "model": "vad/silero_vad.onnx" }, "contextTokens": 0, "maxTokens": 0, "threads": 1 },
    "emotion": { "backend": "onnxruntime", "role": "emotion", "device": "cpu", "paths": { "model": "emotion/model.onnx", "tokenizer": "emotion/tokenizer.json" }, "contextTokens": 0, "maxTokens": 0, "threads": 2 },
    "tts": { "backend": "onnxruntime", "role": "tts", "device": "cpu", "paths": {
      "text_embed": "tts/qwen3-tts-12hz-0.6b-customvoice/text_embed.onnx",
      "codec_embed": "tts/qwen3-tts-12hz-0.6b-customvoice/codec_embed.onnx",
      "residual_embed": "tts/qwen3-tts-12hz-0.6b-customvoice/residual_embed.onnx",
      "talker": "tts/qwen3-tts-12hz-0.6b-customvoice/talker_cache.onnx",
      "code_predictor": "tts/qwen3-tts-12hz-0.6b-customvoice/code_predictor.onnx",
      "tok_decoder": "tts/qwen3-tts-12hz-0.6b-customvoice/tok_decoder.onnx",
      "config": "tts/qwen3-tts-12hz-0.6b-customvoice/config.json",
      "vocab": "tts/qwen3-tts-12hz-0.6b-customvoice/vocab.json",
      "merges": "tts/qwen3-tts-12hz-0.6b-customvoice/merges.txt"
    }, "contextTokens": 0, "maxTokens": 2048, "threads": 2 }
  }
}
